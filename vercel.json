{
  "$schema": "https://vercel.sh",
  "buildCommand": "mkdir -p dist && cp -R art4sells/public dist/public && cp -R art4sells/src dist/src",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://googleapis.com; font-src https://gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ],
  "functions": {
    "art4sells/api/index.py": {
      "includeFiles": "art4sells/backend/**",
      "excludeFiles": "{art4sells/backend/tests/**,art4sells/backend/data/**,art4sells/backend/logs/**,art4sells/training/**,art4sells/docs/**,art4sells/scripts/**,art4sells/uploads/**}",
      "maxDuration": 30
    }
  }
}
